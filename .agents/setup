#!/usr/bin/env bash
set -euo pipefail

NODE_VERSION="22.23.2"
GO_VERSION="1.26.1"
PNPM_VERSION="10.28.2"

step() {
  local label="$1"
  shift
  echo "==> $label"
  time "$@"
}

install_node() {
  if command -v node >/dev/null 2>&1 && [ "$(node --version)" = "v${NODE_VERSION}" ]; then
    return
  fi

  local arch install_dir archive
  case "$(dpkg --print-architecture)" in
    amd64) arch="x64" ;;
    arm64) arch="arm64" ;;
    *) echo "Unsupported architecture: $(dpkg --print-architecture)" >&2; return 1 ;;
  esac

  install_dir="/usr/local/lib/node-v${NODE_VERSION}"
  archive="$(mktemp)"
  curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.xz" -o "$archive"
  sudo rm -rf "$install_dir"
  sudo mkdir -p "$install_dir"
  sudo tar -xJf "$archive" -C "$install_dir" --strip-components=1
  rm -f "$archive"

  for executable in node npm npx corepack; do
    sudo ln -sfn "$install_dir/bin/$executable" "/usr/local/bin/$executable"
  done
}

install_go() {
  if command -v go >/dev/null 2>&1 && [ "$(go env GOVERSION)" = "go${GO_VERSION}" ]; then
    return
  fi

  local arch install_dir archive
  case "$(dpkg --print-architecture)" in
    amd64) arch="amd64" ;;
    arm64) arch="arm64" ;;
    *) echo "Unsupported architecture: $(dpkg --print-architecture)" >&2; return 1 ;;
  esac

  install_dir="/usr/local/lib/go-${GO_VERSION}"
  archive="$(mktemp)"
  curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" -o "$archive"
  sudo rm -rf "$install_dir"
  sudo mkdir -p "$install_dir"
  sudo tar -xzf "$archive" -C "$install_dir" --strip-components=1
  rm -f "$archive"
  sudo ln -sfn "$install_dir/bin/go" /usr/local/bin/go
  sudo ln -sfn "$install_dir/bin/gofmt" /usr/local/bin/gofmt
}

install_docker() {
  if command -v docker >/dev/null 2>&1; then
    return
  fi

  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
  sudo chmod a+r /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" |
    sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
}

step "Installing Node.js ${NODE_VERSION}" install_node
step "Installing Go ${GO_VERSION}" install_go
step "Installing Docker" install_docker

step "Activating pnpm ${PNPM_VERSION}" corepack prepare "pnpm@${PNPM_VERSION}" --activate

[ -f .env ] || cp -- .env.example .env

step "Installing JavaScript dependencies" pnpm install --frozen-lockfile
step "Downloading Go modules" bash -c 'cd server && go mod download'
step "Starting Docker and PostgreSQL" .agents/resume
step "Running database migrations" bash -c 'set -a; . ./.env; set +a; cd server && go run ./cmd/migrate up'

echo "✓ Orb setup complete"
