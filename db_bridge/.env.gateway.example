# ---------------------------------------------------------------------------
# DeepSeek-backed gateway (scripts/deepseek_gateway.py)
#
# Copy to .env.gateway (git-ignored) and fill in the API key. Source it before
# launching the gateway:
#   cd db_bridge && set -a && source .env.gateway && set +a
#   python3 scripts/deepseek_gateway.py
# ---------------------------------------------------------------------------

# Anthropic-compatible upstream base. DeepSeek exposes one at /anthropic.
GATEWAY_UPSTREAM_URL=https://api.deepseek.com/anthropic
# Upstream API key (DeepSeek). REQUIRED.
GATEWAY_UPSTREAM_API_KEY=sk-your-deepseek-key
# Upstream model forced for every request (incoming areal/* names are remapped).
GATEWAY_MODEL=deepseek-v4-pro

# Loopback bind so only the local db_bridge executor reaches it. Keep this equal
# to BRIDGE_GATEWAY_UPSTREAM_URL in .env.areal (default http://127.0.0.1:8080).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

GATEWAY_ANTHROPIC_VERSION=2023-06-01
GATEWAY_MAX_TOKENS=4096
GATEWAY_UPSTREAM_TIMEOUT=300

# Admin key enforced on /rl/* and /export_trajectories (mirrors the real AReaL
# gateway's require_admin_key). Set equal to multica's AREAL_ADMIN_API_KEY and
# the real AReaL --admin-api-key. Empty disables enforcement (accept all).
GATEWAY_ADMIN_API_KEY=
