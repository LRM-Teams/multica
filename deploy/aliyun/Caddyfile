(multica_app) {
	# `route` makes directive order the literal order written below, instead
	# of Caddy's automatic type-based sort. Needed so the downloads handle_path
	# block reliably wins for /downloads/multica/* ahead of the frontend
	# catch-all reverse_proxy, which has no matcher and would otherwise
	# swallow every request.
	route {
		# Public CLI/daemon release feed. The CLI/daemon manifest client
		# (server/internal/cli/update.go ReleaseManifestBaseURL) and the
		# install script bake in *this* domain, not the storage backend —
		# an unauthenticated request to the private LRM-Teams/multica repo's
		# GitHub API/asset hosts always 404s, so it can never point there.
		# We redirect to wherever the release workflow's publish-downloads-
		# feed job actually put the immutable per-version archives/checksums
		# and the promoted latest.json (OSS bucket today; a future CDN or
		# self-owned domain is a one-line change here, not a client release).
		# handle_path strips the /downloads/multica prefix and, being a
		# `handle` block, owns the response exclusively: a miss here is
		# whatever the redirect target returns, never a fall-through to the
		# app.
		handle_path /downloads/multica/* {
			redir * {env.RELEASES_PUBLIC_ORIGIN}{uri} 302
		}

		@multica_ws path /ws /ws/* /api/daemon/ws /api/sandbox/node/ws
		reverse_proxy @multica_ws backend:8080 {
			flush_interval -1
		}

		@multica_health path /health
		reverse_proxy @multica_health backend:8080

		reverse_proxy frontend:3000
	}
}

leagent.me, www.leagent.me {
	import multica_app
}

# Preserve the IP:8090 endpoint for daemon compatibility and deployment
# verification. Browser navigation uses the secure canonical origin so cookies,
# microphone access, and other secure-context browser APIs remain available.
:8090 {
	@browser_navigation header Accept *text/html*
	redir @browser_navigation https://leagent.me{uri} 308

	import multica_app
}
