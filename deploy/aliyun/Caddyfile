(multica_app) {
	@multica_ws path /ws /ws/* /api/daemon/ws /api/sandbox/node/ws
	reverse_proxy @multica_ws backend:8080 {
		flush_interval -1
	}

	@multica_health path /health
	reverse_proxy @multica_health backend:8080

	reverse_proxy frontend:3000
}

leagent.me, www.leagent.me {
	import multica_app
}

# Preserve the IP:8090 endpoint for daemon compatibility and deployment
# verification. Browser navigation uses the secure canonical origin so cookies,
# microphone access, and other secure-context browser APIs remain available.
:8090 {
	@browser_navigation header Accept *text/html*
	redir @browser_navigation https://leagent.me{uri} 308

	import multica_app
}

# Public, read-only CLI/daemon release feed on its own subdomain: immutable
# per-version archives/checksums plus the promoted latest.json, populated by
# the release workflow's publish-downloads-feed job. The CLI/daemon manifest
# client (server/internal/cli/update.go ReleaseManifestBaseURL) and the
# install script read from here instead of GitHub — an unauthenticated
# request to the private LRM-Teams/multica repo's GitHub API/asset hosts
# always 404s. A dedicated subdomain (not a path under leagent.me) keeps this
# public static content out of the app's Caddy routing entirely and leaves
# room for other public-read content (e.g. attachments) on sibling paths
# later without touching this block.
cdn.leagent.me {
	handle_path /computer/* {
		root * /srv/multica-releases
		# No `browse` subdirective: it is opt-in in Caddy (absent = off).
		# Adding a bare `browse off` is a config bug, not a way to disable
		# it — `off` is parsed as a browse template file path.
		file_server
	}
}
