{
	# HTTPS clients connecting to a literal IP do not send SNI. Select the
	# test site's certificate explicitly so direct-IP setup and health checks
	# complete the TLS handshake.
	default_sni {$MULTICA_TEST_HOST:82.157.184.89}
}

(multica_app) {
	# Canonical DaemonCore socket is /api/daemon/connect.
	# TODO(computer-liveness): Remove /api/daemon/ws after v0.4.24-alpha.55
	# is no longer a supported direct self-upgrade source.
	@multica_ws path /ws /ws/* /api/daemon/connect /api/daemon/ws /api/sandbox/node/ws
	reverse_proxy @multica_ws backend:8080 {
		flush_interval -1
	}

	@multica_health path /health
	reverse_proxy @multica_health backend:8080

	# Long-running API (env-dispatch sandbox boot) must not go through the
	# Next.js 30s rewrite proxy. Caddy default response_header_timeout is also 30s.
	@multica_api path /api /api/*
	reverse_proxy @multica_api backend:8080 {
		transport http {
			dial_timeout 10s
			response_header_timeout 180s
			read_timeout 180s
			write_timeout 180s
		}
	}

	reverse_proxy frontend:3000
}

# Let's Encrypt IP certificates use the short-lived profile and renew
# automatically. HTTP-01 is selected explicitly because it is supported for
# public IPv4 addresses and does not compete with the HTTPS listener.
{$MULTICA_TEST_HOST:82.157.184.89} {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}

	import multica_app
}

# Preserve the existing HTTP entrypoint for daemon/API compatibility and
# rollout verification. Browser navigations are migrated to the secure origin
# so old :8090 bookmarks cannot remain on a UI with unusable Secure cookies.
:8090 {
	@browser_navigation header Accept *text/html*
	redir @browser_navigation https://{$MULTICA_TEST_HOST:82.157.184.89}{uri} 308

	import multica_app
}
