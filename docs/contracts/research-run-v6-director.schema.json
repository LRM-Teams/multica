      "type": "object",
      "additionalProperties": false,
      "required": ["contract_kind", "schema_version", "workspace_id", "run_id", "snapshot_id", "event_sequence", "previous_projection_hash", "projection_hash", "upsert_nodes", "remove_node_ids", "upsert_edges", "remove_edge_ids", "invalidate_slice_keys"],
      "properties": {
        "contract_kind": { "const": "projection_delta" },
        "schema_version": { "const": 6 },
        "workspace_id": { "$ref": "#/$defs/uuid" },
        "run_id": { "$ref": "#/$defs/uuid" },
        "snapshot_id": { "$ref": "#/$defs/uuid" },
        "event_sequence": { "$ref": "#/$defs/sequence" },
        "previous_projection_hash": { "$ref": "#/$defs/hash" },
        "projection_hash": { "$ref": "#/$defs/hash" },
        "upsert_nodes": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/projection_node" } },
        "remove_node_ids": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
        "upsert_edges": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/projection_edge" } },
        "remove_edge_ids": { "type": "array", "maxItems": 20000, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
        "invalidate_slice_keys": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } }
      }
    }
  }
