    "projection_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_kind", "schema_version", "snapshot_id", "workspace_id", "run_id", "through_event_sequence", "projection_hash", "slice_key", "nodes", "edges", "density_bins", "has_more"],
