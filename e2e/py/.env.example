# Env-Dispatch Issue E2E harness configuration.
# Copy to `.env` (gitignored) and fill in values for the shared deployment.
# Contract: specs/002-env-dispatch-issue-e2e/contracts/harness-config.md

# --- Required (suite skips when any is absent) ---

# multica server base URL
MULTICA_BASE_URL=http://<server-host>:8090

# Workspace scoping — exactly one of the two (sent as a query param)
MULTICA_WORKSPACE_ID=
# MULTICA_WORKSPACE_SLUG=my-team

# Personal Access Token (Bearer). Lowest-precedence fallback:
# MULTICA_CREDENTIALS_FILE pointing at a JSON file {"api_key": "pat_..."}
MULTICA_API_KEY=
# MULTICA_CREDENTIALS_FILE=/path/to/credentials.json

# Target agent UUID (squad product retired — env-dispatch requires agent_id)
MULTICA_AGENT_ID=

# Base env (mode='base') built from the fixture Cube template — scratch stage
# source. Produced once by `python provision_fixture.py`.
MULTICA_BASE_ENV_ID=

# Cube HTTP proxy for /execute. If unreachable directly:
#   ssh -L 8080:127.0.0.1:80 <user>@<sandbox-host>
# and use http://127.0.0.1:8080
CUBE_PROXY_URL=http://<cube-proxy-host>

# --- Optional (defaults shown) ---

# vhost domain for the sandbox Host header
CUBE_DOMAIN=cube.app

# Per-stage completion wait budget, seconds (3 stages < 60 min total)
E2E_STAGE_TIMEOUT_SEC=1200

# DAG poll interval, seconds
E2E_DAG_POLL_INTERVAL_SEC=10

# 1 => swap in an unsatisfiable acceptance check; the run MUST fail at the
# verification phase (negative control, FR-010)
E2E_NEGATIVE_CONTROL=0
