{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "apps/web/app/**/{page,layout,route,default,error,loading,not-found,template}.{ts,tsx}!",
    "apps/web/app/**/opengraph-image.{ts,tsx}!",
    "apps/web/middleware.ts!",
    "apps/web/proxy.ts!",
    "apps/web/next.config.ts!",
    "apps/web/instrumentation.ts!",
    "packages/views/**/*.{test,spec}.{ts,tsx}",
    "packages/ui/**/*.{test,spec}.{ts,tsx}",
    "packages/core/**/*.{test,spec}.{ts,tsx}",
    "apps/web/**/*.{test,spec}.{ts,tsx}"
  ],
  "project": [
    "apps/web/**/*.{ts,tsx}",
    "packages/views/**/*.{ts,tsx}",
    "packages/ui/**/*.{ts,tsx}",
    "packages/core/**/*.{ts,tsx}"
  ],
  "ignore": [
    "**/*.d.ts",
    "**/locales/**",
    "**/dist/**",
    "**/node_modules/**",
    "apps/desktop/**",
    "apps/mobile/**",
    "apps/docs/**"
  ],
  "ignoreBinaries": [
    "turbo",
    "pnpm",
    "react-doctor"
  ],
  "ignoreDependencies": [
    "turbo",
    "react-doctor",
    "vite",
    "typescript",
    "pg",
    "@types/pg",
    "@types/node",
    "@playwright/test"
  ]
}