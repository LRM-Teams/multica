# Copy to .env.docker and fill in real values:
#   cp .env.docker.example .env.docker

# --- Required: shared Supabase ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Scope all rows to one user (recommended for a dedicated deployment).
BRIDGE_USER_ID=00000000-0000-0000-0000-000000000000

# --- Gateway stub (Cube sandbox -> db_bridge) ---
BRIDGE_GATEWAY_STUB_PORT=9100

# Pi default (configure-pi-runtime.sh):
#   AREAL_BASE_URL=http://db_bridge_stub:9100/v1
# Cube tap-network sandboxes cannot resolve db_bridge_stub. Use the host LAN IP
# in allowOut (not 192.168.0.1 — hairpin to cube-dev is broken for :9100):
#   AREAL_BASE_URL=http://10.110.158.143:9100/v1
# After adding the LAN IP to allowOut, run on the Cube host (once per boot):
#   sudo scripts/cube-tap-tproxy-init.sh up
# db_bridge_stub must use network_mode: host (see docker-compose.yml). A
# published :9100 via docker-proxy breaks Cube allowOut hairpin.

# --- Gateway executor (db_bridge -> real LLM gateway on this host) ---
# gateway-executor uses network_mode: host, so 127.0.0.1 reaches the host loopback.
# WARNING: 192.168.0.1:8080 on Cube nodes is cube-egress (TPROXY), NOT the AReaL
# gateway — direct HTTP from the executor gets 403 from openresty.
# Local dev (no AReaL gateway process): use docker compose gateway-mock -> :18080
BRIDGE_GATEWAY_UPSTREAM_URL=http://127.0.0.1:18080
# Production AReaL host with a real proxy gateway listening on loopback:
# BRIDGE_GATEWAY_UPSTREAM_URL=http://127.0.0.1:8080

# --- Tuning ---
BRIDGE_POLL_INTERVAL=0.075
BRIDGE_TIMEOUT_CHAT_COMPLETIONS=180
BRIDGE_CLEANUP_INTERVAL=300
BRIDGE_ROW_RETENTION_SECONDS=86400
