# ---------------------------------------------------------------------------
# db_bridge environment — MULTICA HOST (public internet)
#
# The multica server is the only INTERNET-EXPOSED bridge surface. It accepts
# OpenAI-compatible LLM calls and remote-shell enqueue requests from untrusted
# callers, authenticates them with static API keys, and parks the work in the
# shared Supabase database. The AReaL-side executor (LLM) and shell runner
# drain the work; multica never connects to AReaL directly.
#
# Run it (behind a reverse proxy — see the bind warning below):
#   cd db_bridge && set -a && source .env.multica && set +a
#   uv run python -m db_bridge.run_multica
# ---------------------------------------------------------------------------

# Shared Supabase project (same project AReaL + le-agent use). Service-role key
# required: the bridge tables have RLS enabled with a service-role-only policy.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fixed shared user that ALL multica traffic is enqueued under. Use a DISTINCT
# UUID from le-agent's BRIDGE_USER_ID so external traffic stays isolated in the
# shared rpc_chat_completions / areal_remote_commands tables.
MULTICA_BRIDGE_USER_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Static API keys (comma-separated). Auth is FAIL-CLOSED: an empty key set
# rejects every request to that surface. The two sets are intentionally
# SEPARATE — the shell endpoint enqueues arbitrary code that runs on the
# trusted AReaL host, so it must not share a key with the LLM endpoint.
#
# Callers present a key as either:
#   Authorization: Bearer <key>
#   X-API-Key: <key>
# ---------------------------------------------------------------------------
MULTICA_LLM_API_KEYS=llm-key-1,llm-key-2
MULTICA_SHELL_API_KEYS=shell-key-1

# ---------------------------------------------------------------------------
# Bind. The container/process binds MULTICA_BIND_HOST:MULTICA_PORT. Keep it
# behind a reverse proxy (Caddy / nginx / Cloudflare Tunnel) that terminates
# TLS; the docker-compose service maps only 127.0.0.1:${MULTICA_PORT}. The only
# caller authentication is the static API keys above — do NOT expose the raw
# port to the open internet without a proxy + TLS.
# ---------------------------------------------------------------------------
MULTICA_BIND_HOST=0.0.0.0
MULTICA_PORT=9200

# ---------------------------------------------------------------------------
# LLM relay. Only models starting with "areal/" are accepted (others -> 400).
# Streaming (stream:true) IS supported: the request is parked as usual, the
# AReaL executor relays the upstream SSE into bridge_stream_chunks, and this
# server replays those chunks to the caller as a text/event-stream response.
# ---------------------------------------------------------------------------
# How long to wait for the AReaL executor's response before returning 504.
MULTICA_CHAT_TIMEOUT=180
# DB polling for the response row (1s; LLM latency dominates).
BRIDGE_POLL_INTERVAL=1
# Reject request bodies larger than this (bytes) with 413.
BRIDGE_MAX_BODY_BYTES=67108864
# Optional: auth replayed to the REAL AReaL gateway. The inbound multica API
# key is always stripped before forwarding; when this is set, it is injected as
# `Authorization: Bearer <key>` so the AReaL gateway sees a valid upstream key.
# Leave unset to forward no Authorization header upstream.
# MULTICA_UPSTREAM_API_KEY=

# ---------------------------------------------------------------------------
# Streaming (SSE) relay — caller side. These govern how this server waits for
# and polls the chunks the AReaL executor writes.
# ---------------------------------------------------------------------------
# Max seconds to wait for the stream to BEGIN (first chunk / headers) -> 504.
MULTICA_STREAM_FIRST_CHUNK_TIMEOUT=60
# Max seconds tolerated between chunks once streaming has begun.
MULTICA_STREAM_INTER_CHUNK_TIMEOUT=120
# How often to poll bridge_stream_chunks for new chunks (seconds). Smaller =
# lower per-chunk latency at the cost of more DB reads.
MULTICA_STREAM_POLL_INTERVAL=0.05

# ---------------------------------------------------------------------------
# Remote-shell enqueue API (/shell/commands). These rows are claimed and
# executed by the EXISTING AReaL-host shell runner (run_shell_runner) — this
# server only inserts PENDING rows and reads status / requests cancellation.
#
# ⚠ This is remote code execution on the AReaL host for any caller holding a
# shell key. It is NOT a sandbox. Treat MULTICA_SHELL_API_KEYS as highly
# sensitive and only enable the AReaL runner on intentionally-trusted hosts.
# ---------------------------------------------------------------------------
# Default per-command timeout (seconds) when a request omits one.
MULTICA_SHELL_DEFAULT_TIMEOUT=300
# Upper bound a requested per-command timeout is clamped to.
MULTICA_SHELL_MAX_TIMEOUT=3600
# Working directory used when a command omits `cwd`.
# MULTICA_SHELL_DEFAULT_CWD=/root/AReaL

# AReaL reaches the Multica Go API directly with a PAT. No Multica-side
# db_bridge executor is required. The retained Multica-side stub serves the
# opposite Multica-to-AReaL gateway direction.
