        "language": "zh-CN",
        "allowed_tools": ["controlled_agent_registry", "controlled_graph"],
        "tags": ["autonomy", "team_formation", "director_authority", "idempotency"]
      },
      "environment": {
        "documents": [
          {
            "id": "team-contract",
            "family": "run-contract",
            "title": "受控组队授权",
            "version": "1",
            "content": "本次运行固定 Research Director，允许创建一名独立复核 Agent；重复提案必须复用，任务完成后成员退出。"
          }
        ]
      },
      "oracle": {
        "required_facts": [],
        "autonomy": {
          "required_actions": [
            {"kind": "team_formation_proposed", "actor": "research_director", "target": "independent-verifier", "outcome": "accepted"},
